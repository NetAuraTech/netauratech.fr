# Node
TZ=UTC
PORT=3334
HOST=localhost
NODE_ENV=test

# App
LOG_LEVEL=warn
APP_KEY=dummy_key_for_testing_12345678901234567890
APP_URL=http://localhost:3334
APP_NAME=AdonisJS Foundry

# Session
SESSION_DRIVER=memory

# Auth guards — tests exercise both guards (session + token).
AUTH_GUARD_WEB=true
AUTH_GUARD_API=true
AUTH_API_TOKEN_EXPIRY=30 days

# Database
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=user
PG_PASSWORD=password
PG_DB_NAME=app_test

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SOCKET=

# Mail
MAIL_MAILER=smtp
MAIL_FROM_NAME=${APP_NAME}
MAIL_FROM_ADDRESS=contact@example.com

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=username
SMTP_PASSWORD=password

# Sentry
SENTRY_DSN=https://dummy@sentry.io/12345

# Oauth
FACEBOOK_CLIENT_ID=dummy
FACEBOOK_CLIENT_SECRET=dummy
GITHUB_CLIENT_ID=dummy
GITHUB_CLIENT_SECRET=dummy
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
DRIVE_DISK=fs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
R2_KEY=
R2_SECRET=
R2_BUCKET=
R2_ENDPOINT=
LIMITER_STORE=memory
