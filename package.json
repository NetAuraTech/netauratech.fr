{
  "name": "adonisjs-foundry",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "docker:up": "docker compose up -d",
    "docker:stop": "docker compose stop -d",
    "test": "node ace test",
    "test:front": "vitest run",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "postinstall": "patch-package"
  },
  "imports": {
    "#controllers/*": "./app/http/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#helpers/*": "./app/helpers/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/http/middleware/*.js",
    "#repositories/*": "./app/domain/repositories/*.js",
    "#services/*": "./app/domain/services/*.js",
    "#contracts/*": "./app/domain/contracts/*.js",
    "#transformers/*": "./app/data/transformers/*.js",
    "#types/*": "./app/types/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#factories/*": "./database/factories/*.js",
    "#shared/*": "./app/shared/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#actions/*": "./app/domain/actions/*.js",
    "#cms/*": "./app/cms/*.js",
    "#prune/*": "./tooling/prune/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.1.0",
    "@japa/runner": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/luxon": "^3.7.3",
    "@types/node": "~24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^21.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.0.2",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.0.0",
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/i18n": "^3.0.0",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.0",
    "@adonisjs/vite": "^5.1.0",
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/jost": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@iconify/react": "^6.0.2",
    "@inertiajs/react": "^2.3.22",
    "@rlanz/sentry": "^0.3.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tuyau/core": "^1.0.0",
    "@vinejs/vine": "^4.3.0",
    "better-sqlite3": "^12.6.2",
    "dompurify": "^3.4.13",
    "edge.js": "^6.5.0",
    "html-to-image": "^1.11.13",
    "ipaddr.js": "^2.4.0",
    "jsdom": "^29.0.1",
    "luxon": "^3.7.2",
    "patch-package": "^8.0.1",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-raw": "^7.0.0",
    "sharp": "^0.35.3",
    "sinon": "^21.0.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/http/controllers/**/*.ts",
      "./app/http/middleware/**/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
